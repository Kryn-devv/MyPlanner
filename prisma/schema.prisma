// ---------------------------------------------------------------------------
// NOVA — data model (Phases 1–3)
//
// Design notes
// ------------
// * Everything user-owned carries a `userId` and cascades on user deletion.
//   Every query in the app filters by `userId`; the indexes below are built
//   around that access pattern.
// * `Task` carried nullable forward-reference columns from Phase 1. Two of
//   them — projectId and milestoneId — are now real foreign keys; the rest
//   (goal, habit, meeting, event) stay plain nullable columns until their
//   tables exist. That prediction paid off: Phase 2 added constraints to
//   existing columns rather than rewriting the task table.
// * Ownership of a Milestone flows through its Project rather than being
//   denormalised onto the row. One owner column cannot drift from another,
//   and every milestone query already has to load or filter by project.
// * The hierarchy is Goal -> Project -> Milestone -> Task, and each level is
//   reached through exactly one path. A task's goal is its project's goal;
//   there is deliberately no Task.goalId, because two paths could disagree
//   about which goal a task serves and nothing could adjudicate between them.
// * XP is an append-only ledger (`XpTransaction`). `UserStats.totalXp` is a
//   cached rollup of that ledger and is only ever mutated inside the same
//   database transaction that writes the ledger row.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  // Emit explicit file extensions in the generated client's own imports.
  // Without this the client's internal `./enums` specifiers are unresolvable
  // by Node's ESM loader, which is what runs the seed script directly.
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Where an XP ledger entry came from. Phase 2+ will add STREAK_BONUS,
/// HABIT_COMPLETION, GOAL_MILESTONE, FOCUS_SESSION, ACHIEVEMENT.
enum XpSource {
  TASK_COMPLETION
  ADJUSTMENT
}

/// Lifecycle of a strategic objective.
///
/// Mirrors ProjectStatus deliberately — the two are read side by side, and a
/// different vocabulary at each level would be noise. Status is never inferred
/// from the work underneath: a goal whose every task is ticked is not
/// necessarily achieved, and deciding that for the user is not the app's call.
enum GoalStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Lifecycle of a piece of larger work.
///
/// COMPLETED and ARCHIVED are deliberately separate: "finished" and "put away"
/// are different statements, and conflating them loses information the user
/// cares about. Both are set explicitly — never inferred from task counts.
enum ProjectStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

/// Milestones are intentionally binary. A milestone with its own rich status
/// machine is a project; keeping this to two states is what stops the
/// hierarchy collapsing into itself.
enum MilestoneStatus {
  PENDING
  COMPLETED
}

/// Lifecycle of a period of focused work.
///
/// One status rather than a set of booleans: `isRunning`/`isPaused`/`isDone`
/// can express "running and completed", which is not a thing, and every read
/// would then have to decide which flag wins. A session is in exactly one of
/// these four states, and the legal transitions are enumerated in
/// src/lib/focus/machine.ts.
///
/// CANCELLED is kept rather than deleted: discarding the row would lose the
/// fact that the period happened, and a cancelled session simply does not
/// count towards focused time.
enum FocusSessionStatus {
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

/// AWARD adds XP, REVERSAL takes it back when the underlying event is undone.
/// Storing both as ledger rows keeps the running total auditable instead of
/// destructively editing history.
enum XpEntryKind {
  AWARD
  REVERSAL
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String @id @default(cuid())
  email        String @unique
  /// scrypt hash, formatted as `scrypt$N$r$p$salt$derivedKey`.
  passwordHash String
  name         String

  /// IANA timezone (e.g. "Europe/Berlin"). All "today"/streak logic resolves
  /// the calendar day through this, never through the server's clock.
  timezone String @default("UTC")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  tasks          Task[]
  categories     Category[]
  goals          Goal[]
  projects       Project[]
  xpTransactions XpTransaction[]
  focusSessions  FocusSession[]
  stats          UserStats?

  @@index([email])
}

/// Opaque server-side sessions. Phase 2 can add an `Account` table keyed by
/// (provider, providerAccountId) for OAuth without touching this model: the
/// session is already decoupled from the credential that created it.
model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the cookie token. The raw token is never persisted, so a
  /// database leak does not hand over live sessions.
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Task domain
// ---------------------------------------------------------------------------

model Category {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  /// Design-token name (see src/config/categories.ts). Storing a token rather
  /// than a hex value keeps categories theme-aware.
  color String  @default("slate")
  icon  String?

  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks Task[]

  @@unique([userId, name])
  @@index([userId, isArchived])
}

// ---------------------------------------------------------------------------
// Goal domain
// ---------------------------------------------------------------------------

/// A strategic objective — the reason a body of work exists.
///
/// A goal answers "where am I trying to get?"; a project answers "what am I
/// building?". Keeping them distinct is the point of this layer, so a Goal
/// deliberately has no colour, no milestones and no tasks of its own: it owns
/// none of the work, it only gives projects a reason.
///
/// Progress is derived from the tasks inside its projects (see
/// src/lib/goals/progress.ts) and is never stored. Status is always explicit.
model Goal {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  title       String
  description String?

  status   GoalStatus @default(ACTIVE)
  priority Priority   @default(MEDIUM)

  /// Calendar dates in the user's timezone, stored as DATE for the same reason
  /// Project.dueDate is: a deadline is a day, not an instant.
  startDate  DateTime? @db.Date
  /// What the user is aiming at. Called `targetDate` rather than `dueDate`
  /// because a goal is an intention, not an obligation handed to you.
  targetDate DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
  archivedAt  DateTime?

  projects Project[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, targetDate])
  // Serves the default list: this user's active goals, soonest target first.
  @@index([userId, status, targetDate])
}

// ---------------------------------------------------------------------------
// Project domain
// ---------------------------------------------------------------------------

/// A body of work that tasks belong to.
///
/// `status` is always set by an explicit user action. It is never derived from
/// task counts — a project whose tasks all happen to be ticked is not
/// necessarily finished, and silently deciding otherwise would take a
/// judgement away from the person making it. Progress *is* derived (see
/// src/lib/projects/progress.ts); status is not.
model Project {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// The objective this project serves, if any. Optional on purpose: plenty of
  /// work is worth doing without laddering up to a stated goal, and forcing a
  /// goal on every project would make the layer a chore rather than a lens.
  ///
  /// `onDelete: SetNull` — deleting a goal releases its projects, it never
  /// destroys them. Same policy as project -> task, one level up.
  goal   Goal?   @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalId String?

  name        String
  description String?

  /// Design-token name from src/config/colors.ts — the same restrained palette
  /// categories use. A token rather than a hex value keeps the accent
  /// theme-aware and keeps users from choosing an unreadable colour.
  color String @default("violet")

  status   ProjectStatus @default(ACTIVE)
  priority Priority      @default(MEDIUM)

  /// Calendar dates in the user's timezone, stored as DATE for the same reason
  /// Task.dueDate is: a deadline is a day, not an instant.
  startDate DateTime? @db.Date
  dueDate   DateTime? @db.Date

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  /// Set when status becomes COMPLETED, cleared when it is reopened.
  completedAt DateTime?
  /// Set when status becomes ARCHIVED, cleared on restore. Kept separate from
  /// completedAt so archiving a finished project does not erase when it was
  /// finished.
  archivedAt  DateTime?

  milestones Milestone[]
  tasks      Task[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, dueDate])
  // Serves the default list: this user's active projects, soonest deadline first.
  @@index([userId, status, dueDate])
  @@index([goalId])
  // Serves "this user's projects under this goal", the goal detail page's
  // main query and the project list's goal filter.
  @@index([userId, goalId])
}

/// A checkpoint within a project.
///
/// Has no `userId` of its own: ownership is the project's, reached through the
/// relation. A denormalised copy would be a second source of truth that could
/// silently disagree with the first.
model Milestone {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  title       String
  description String?

  dueDate DateTime?       @db.Date
  status  MilestoneStatus @default(PENDING)

  /// Manual ordering within a project. Sparse and rewritten on reorder, so
  /// gaps are expected and meaningless.
  position Int @default(0)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  tasks Task[]

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, dueDate])
  @@index([projectId, position])
}

model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  completed   Boolean  @default(false)
  priority    Priority @default(MEDIUM)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Calendar date in the user's timezone, stored as a DATE so it never shifts
  /// when the server and the user disagree about the current offset.
  dueDate DateTime? @db.Date
  /// Wall-clock "HH:mm" in the user's timezone. Kept separate from dueDate so
  /// an all-day task and a timed task are distinguishable.
  dueTime String?

  estimatedMinutes Int?

  /// Authoritative XP for this task. Written by the server from the priority
  /// default (or an explicit, validated user override) — never trusted from
  /// the client at completion time.
  xpReward Int @default(20)

  /// Number of times this task has transitioned false -> true. Used as the
  /// ledger cycle key so re-completing a reopened task cannot double-award.
  completionCount Int @default(0)

  // -- Project hierarchy (Phase 2) ------------------------------------------
  // `onDelete: SetNull` on both is the whole delete policy: removing a project
  // or a milestone detaches its tasks, it never destroys them. A task is the
  // user's record of work done — losing it because a container was tidied away
  // would be indefensible, and Cascade here would do exactly that.
  //
  // A task may have a project and no milestone. It may never have a milestone
  // without a project, or a milestone belonging to a *different* project; the
  // database cannot express that rule, so the service layer enforces it on
  // every write (see assertTaskAssignment in src/lib/tasks/service.ts).
  project     Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectId   String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  milestoneId String?

  // -- Forward references for features that do not exist yet ----------------
  // Plain nullable columns, kept for the same reason projectId was kept through
  // Phase 1: it made Phase 2 an additive migration instead of a rewrite.
  //
  // `goalId` used to sit here and was deliberately dropped in Phase 3 rather
  // than wired up. A task's goal is its project's goal. A second, direct link
  // would let a task claim one goal while its project served another, with
  // nothing able to decide which is right — and goal progress would have no
  // defensible definition. The column was provably unused (every row NULL, no
  // code referencing it), so removing it was safer than leaving something that
  // reads like a relation waiting to be connected.
  habitId   String?
  meetingId String?
  eventId   String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  xpTransactions XpTransaction[]
  focusSessions  FocusSession[]

  @@index([userId])
  @@index([completed])
  @@index([dueDate])
  @@index([userId, completed])
  @@index([userId, dueDate])
  // Serves the dashboard's "open tasks, soonest first" query in one scan.
  @@index([userId, completed, dueDate])
  @@index([userId, categoryId])
  @@index([userId, completedAt])
  @@index([projectId])
  @@index([milestoneId])
  // Project detail and the task page's project filter both read
  // "this user's tasks in this project".
  @@index([userId, projectId])
  @@index([userId, milestoneId])
  @@index([habitId])
}

// ---------------------------------------------------------------------------
// Progression
// ---------------------------------------------------------------------------

/// Append-only XP ledger. Never updated or deleted in normal operation.
model XpTransaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Signed: positive for AWARD, negative for REVERSAL. Summing the column
  /// for a user always reproduces UserStats.totalXp.
  amount Int
  source XpSource    @default(TASK_COMPLETION)
  kind   XpEntryKind @default(AWARD)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  /// Which completion cycle of the task this entry belongs to. Together with
  /// the unique constraint below this makes double-awarding impossible at the
  /// database level, not just in application code.
  cycle Int @default(0)

  description String?
  createdAt   DateTime @default(now())

  @@unique([taskId, kind, cycle])
  @@index([userId, createdAt])
  @@index([userId, source])
  @@index([taskId])
}

/// Cached aggregates. Always written inside the same transaction as the event
/// that changes them, so they cannot drift from the ledger.
model UserStats {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  totalXp Int @default(0)
  level   Int @default(1)

  currentStreak Int @default(0)
  longestStreak Int @default(0)
  /// "YYYY-MM-DD" as it read on the user's own calendar. Deliberately a string
  /// rather than a timestamp: a local calendar day is not a point in time, and
  /// storing it as one is what makes streaks break across timezones.
  lastCompletedDate String?

  tasksCompleted Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Focus domain
// ---------------------------------------------------------------------------

/// A period of focused work, recorded as it happens.
///
/// This is the first model in the app that stores *elapsed time*, and the
/// design turns on one rule: the browser is never the authority. A client can
/// ask to start, pause, resume, complete or cancel a session; it can never say
/// how long one lasted. Every duration is derived from timestamps this server
/// wrote.
///
/// Elapsed time is therefore reconstructible from the row alone:
///
///   RUNNING   accumulatedSeconds + (now - segmentStartedAt)
///   PAUSED    accumulatedSeconds
///   finished  accumulatedSeconds  (banked when the session ended)
///
/// which is what makes a refresh, a navigation, a sleeping laptop or a closed
/// browser harmless — none of them is where the time was being kept.
///
/// Note `targetMinutes` is an intention, not a measurement. A 25-minute target
/// worked for 18 minutes is 18 minutes of focus, and nothing here ever rounds
/// one up to the other.
///
/// At most one session per user may be RUNNING or PAUSED. That is enforced by
/// a partial unique index created in the Phase 4.3 migration — Prisma's schema
/// language cannot express a filtered index, so it does not appear below. See
/// the migration and src/lib/focus/service.ts.
model FocusSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Nullable and SetNull on delete, unlike most of the app's relations: a
  /// record of time you actually spent should outlive the task it was spent
  /// on. A detached session still counts towards your history; it just no
  /// longer says what it was for.
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)
  taskId String?

  status FocusSessionStatus @default(RUNNING)

  /// The intended length, when the user picked one. Never the actual length.
  targetMinutes Int?

  /// Seconds banked by segments that have already ended. The only place
  /// elapsed time is stored, and it is only ever written by the server.
  accumulatedSeconds Int @default(0)

  /// When the current RUNNING segment began. Null whenever the clock is not
  /// moving — which is exactly what distinguishes a paused session from a
  /// running one without consulting `status` twice.
  segmentStartedAt DateTime?

  /// When the session began. Doubles as the creation timestamp, so there is no
  /// second column that means the same thing.
  startedAt DateTime  @default(now())
  /// When it reached COMPLETED or CANCELLED. Null while it is still live.
  endedAt   DateTime?

  updatedAt DateTime @updatedAt

  /// "Is anything active for this user?" — the shell asks on every page.
  @@index([userId, status])
  /// A task's focus history, and its completed-seconds aggregate.
  @@index([taskId, status])
  /// Today's tracked focus: this user's finished sessions in a time window.
  @@index([userId, endedAt])
}
