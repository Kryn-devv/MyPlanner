# ---------------------------------------------------------------------------
# NOVA — environment configuration
# Copy to `.env` and adjust for your machine.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://nova:nova@127.0.0.1:5432/nova_dev?schema=public"

# Separate database used by the integration test suite. It is reset on every run,
# so never point this at a database holding real data.
TEST_DATABASE_URL="postgresql://nova:nova@127.0.0.1:5432/nova_test?schema=public"

# Secret used to derive session-token hashes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must be at least 32 characters. Rotating it invalidates every active session.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Product name. The brand is not hard-coded anywhere in the source; change it
# here and it updates across the UI, metadata and emails.
NEXT_PUBLIC_APP_NAME="NOVA"

# ---------------------------------------------------------------------------
# Password reset email (optional)
#
# With none of these set, nothing is emailed: "Forgot password?" prints the
# reset link in the terminal window running the server, and the page tells the
# user to look there. That is enough for a personal install.
#
# To email links instead, set APP_URL, EMAIL_FROM and ONE of RESEND_API_KEY or
# SMTP_URL (Resend wins if both are set).
# ---------------------------------------------------------------------------

# The address people open the app at; reset links are built from it. REQUIRED
# once email is configured — without it, links would have to come from the
# request's Host header, which anyone can forge to point a genuine reset email
# at their own server. Use your LAN address to open links on a phone. With no
# email configured, printed links use it too, or http://localhost:<port> when
# it is unset — never the address a request claims.
# APP_URL="http://192.168.1.20:3000"

# Who the email comes from. Must be an address your provider lets you send as.
# EMAIL_FROM="NOVA <you@gmail.com>"

# Option 1 — Resend (https://resend.com). EMAIL_FROM must be on a domain you
# have verified with Resend.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"

# Option 2 — any SMTP server, as one URL. For Gmail: turn on 2-Step
# Verification, create an App Password (Google Account → Security → App
# passwords) and paste its 16 letters without spaces. The "@" in your address
# is written %40. Port 465 with smtps:// is Gmail's implicit-TLS endpoint.
# SMTP_URL="smtps://you%40gmail.com:abcdefghijklmnop@smtp.gmail.com:465"
