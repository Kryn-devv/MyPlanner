<?xml version="1.0" encoding="utf-8"?>
<!-- The root takes the system-bar, cutout and keyboard insets as padding, so the web page is
     never drawn under the bars and its form fields are never hidden behind the keyboard. The
     dark background is the window's own (Theme.Nova), so no view repaints it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MergeRootFrame">

    <!-- The WebView is created in code and added here, so it can be rebuilt if its renderer
         process dies without recreating the whole screen. -->
    <FrameLayout
        android:id="@+id/web_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:maxHeight="3dp"
        android:minHeight="3dp"
        android:progressDrawable="@drawable/page_progress"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/error_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/nova_void"
        android:clickable="true"
        android:fillViewport="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nova_mark" />

            <TextView
                style="@style/Nova.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:accessibilityHeading="true"
                android:text="@string/error_title"
                tools:targetApi="28" />

            <TextView
                android:id="@+id/error_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:textColor="@color/nova_ink"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/error_detail"
                style="@style/Nova.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:visibility="gone" />

            <TextView
                style="@style/Nova.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/error_causes_heading" />

            <TextView
                android:id="@+id/error_cause_server"
                style="@style/Nova.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/error_cause_wifi"
                style="@style/Nova.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/error_cause_address"
                style="@style/Nova.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/error_retry"
                style="@style/Nova.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="@string/error_retry" />

            <Button
                android:id="@+id/error_change_server"
                style="@style/Nova.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/error_change_server" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
