<?xml version="1.0" encoding="utf-8"?>
<!-- The root takes the system-bar and keyboard insets as padding, so the ScrollView inside it
     shrinks when the keyboard opens (what adjustResize did before Android 15) and can scroll
     the Connect button back into view. Padding the ScrollView itself would not do: it scrolls a
     view into its full height, padding included, which is exactly where the keyboard sits.
     The dark background is the window's own (Theme.Nova), so no view repaints it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/connect_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="UselessParent,MergeRootFrame">

    <ScrollView
        android:id="@+id/connect_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/connect_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingTop="32dp"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingBottom="32dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:importantForAccessibility="no"
                android:src="@drawable/nova_mark" />

            <TextView
                style="@style/Nova.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:text="@string/connect_title"
                tools:targetApi="28" />

            <TextView
                style="@style/Nova.Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/connect_explanation" />

            <TextView
                android:id="@+id/address_label"
                style="@style/Nova.Text.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:labelFor="@+id/address"
                android:text="@string/connect_field_label" />

            <EditText
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="@dimen/control_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/field_background"
                android:fontFamily="monospace"
                android:imeOptions="actionGo|flagNoExtractUi"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/nova_ink"
                android:textColorHint="@color/nova_ink_faint"
                android:textSize="16sp" />

            <!-- One line for progress and errors alike; a live region, so a screen reader
                 announces what happened without the person having to go looking for it. -->
            <LinearLayout
                android:id="@+id/status_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/status_spinner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="10dp"
                    android:indeterminateTint="@color/nova_accent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/status_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:lineSpacingMultiplier="1.2"
                    android:textColor="@color/nova_ink_muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/connect_button"
                style="@style/Nova.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/connect_button" />

            <TextView
                style="@style/Nova.Text.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/connect_footnote" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
