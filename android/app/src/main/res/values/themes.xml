<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark, like the web app. The bar colours matter on Android 8 to 14; Android 15
         draws the bars transparent over the app's own dark background instead. -->
    <style name="Base.Theme.Nova" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nova_void</item>
        <item name="android:colorBackground">@color/nova_void</item>
        <item name="android:statusBarColor">@color/nova_void</item>
        <item name="android:navigationBarColor">@color/nova_void</item>
        <item name="android:colorPrimary">@color/nova_void</item>
        <item name="android:colorPrimaryDark">@color/nova_void</item>
        <item name="android:colorAccent">@color/nova_accent</item>
        <item name="android:colorControlActivated">@color/nova_accent</item>
        <item name="android:textColorPrimary">@color/nova_ink</item>
        <item name="android:textColorSecondary">@color/nova_ink_muted</item>
        <item name="android:textColorHint">@color/nova_ink_faint</item>
        <item name="android:textColorHighlight">@color/nova_accent_deep</item>
    </style>

    <!-- values-v29 extends this with the attributes only Android 10+ understands. -->
    <style name="Theme.Nova" parent="Base.Theme.Nova" />

    <style name="Nova.Text.Title" parent="">
        <item name="android:textColor">@color/nova_ink</item>
        <item name="android:textSize">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Nova.Text.Body" parent="">
        <item name="android:textColor">@color/nova_ink_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="Nova.Text.Label" parent="">
        <item name="android:textColor">@color/nova_ink_muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Nova.Text.Small" parent="">
        <item name="android:textColor">@color/nova_ink_faint</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Nova.Button" parent="android:Widget.Material.Button">
        <item name="android:minHeight">@dimen/control_height</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Nova.Button.Primary">
        <item name="android:background">@drawable/button_primary</item>
        <item name="android:textColor">@color/button_primary_text</item>
    </style>

    <style name="Nova.Button.Secondary">
        <item name="android:background">@drawable/button_secondary</item>
        <item name="android:textColor">@color/nova_ink</item>
    </style>
</resources>
