<?xml version="1.0" encoding="utf-8"?>
<!-- The NOVA sparkle on the 108dp adaptive-icon canvas. The 16-unit path is scaled 4x (its tips
     span 52dp) and centred, so it sits inside the 66dp safe zone that every launcher mask
     leaves visible. It is plain white with no effects, which also makes it usable as the
     monochrome layer for themed icons. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="4"
        android:scaleY="4"
        android:translateX="22"
        android:translateY="22">
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M8 1.5 9.7 6.3 14.5 8 9.7 9.7 8 14.5 6.3 9.7 1.5 8l4.8-1.7z" />
    </group>
</vector>
