<?xml version="1.0" encoding="utf-8"?>
<!-- The address field: the web app's surface and hairline, with the accent ring on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_surface" />
            <stroke android:width="1.5dp" android:color="@color/nova_accent" />
            <corners android:radius="@dimen/control_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/nova_surface" />
            <stroke android:width="1dp" android:color="@color/nova_line_strong" />
            <corners android:radius="@dimen/control_radius" />
        </shape>
    </item>
</selector>
