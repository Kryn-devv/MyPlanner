<?xml version="1.0" encoding="utf-8"?>
<!-- A flat accent line. The platform's Material progress drawable insets itself vertically and
     draws nothing at all at a 3dp height. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient
                    android:angle="0"
                    android:endColor="@color/nova_xp_to"
                    android:startColor="@color/nova_accent" />
            </shape>
        </clip>
    </item>
</layer-list>
