<?xml version="1.0" encoding="utf-8"?>
<!-- android:allowBackup="false" stops cloud backup, but from Android 12 on it no longer stops a
     device-to-device transfer. The app's data is a signed-in session cookie and one address,
     neither of which should be copied to another phone, so both are excluded outright. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
