# Copy this file to keystore.properties (same folder) to sign release builds
# with your own key. keystore.properties and every *.jks / *.keystore file are
# gitignored: never commit them.
#
# Create a key once with:
#   keytool -genkeypair -v -keystore nova-release.jks -alias nova \
#           -keyalg RSA -keysize 4096 -validity 10000
#
# Without keystore.properties the release APK is signed with the standard
# Android debug key instead, so it always installs.

# Path to the keystore, relative to this android/ folder (or absolute).
storeFile=nova-release.jks
storePassword=change-me
keyAlias=nova
keyPassword=change-me
